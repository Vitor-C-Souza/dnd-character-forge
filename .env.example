# Copy this file to .env for local Docker Compose use.
# Change these development-only credentials before using any shared environment.

# Docker Compose - MySQL Service
MYSQL_DATABASE=characterforge
MYSQL_USER=characterforge
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-only
MYSQL_PORT=3306

# Docker Compose - Application Service
APP_PORT=8080

# Local IDE Execution (Spring Boot Application)
# Use these variables in your IDE Run Configuration when running the app outside Docker:
DB_URL=jdbc:mysql://localhost:3306/characterforge
DB_USERNAME=characterforge
DB_PASSWORD=change-me-local-only
SERVER_PORT=8080